{
  "log-level": "info",

  "live-restore": true,

  "icc": false,

  "no-new-privileges": true,

  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  },

  "default-ulimits": {
    "nofile": {
      "Name": "nofile",
      "Hard": 65535,
      "Soft": 65535
    }
  },

  "storage-driver": "overlay2",

  "exec-opts": ["native.cgroupdriver=systemd"]
}